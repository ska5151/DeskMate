{
  "name": "deskmate",
  "private": true,
  "version": "1.0.0",
  "description": "Windows 바탕화면 멀티플레이어 캐릭터 채팅 프로그램 (React + Electron + Socket.io + Supabase + Rive)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:server": "node server/index.js",
    "dev:electron": "node scripts/start-electron-safe.cjs",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "tsc -b && vite build",
    "vercel-build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:server": "node server/index.js",
    "start:electron": "node scripts/start-electron-safe.cjs",
    "dist:win": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.27.3",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.deskmate.app",
    "productName": "DeskMate",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/tray-icon.ico"
    }
  }
}
